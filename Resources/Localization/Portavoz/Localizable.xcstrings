    },
    "Portavoz could not verify the changes-since evidence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo verificar la evidencia de los cambios desde la reunión."
          }
        }
      }
    },
    "Portavoz could not verify the decision change evidence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo verificar la evidencia del cambio de decisión."
          }
        }
      }
    },
    "Portavoz could not verify the first discussion evidence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo verificar la evidencia de la primera conversación."
          }
        }
      }
    },
    "Portavoz could not verify the returned decision evidence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo verificar la evidencia de la decisión recibida."
          }
        }
      }
    },
    "Portavoz could not verify the returned evidence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo verificar la evidencia devuelta."
          }
        }
      }
    },
    "Portavoz could not verify this receipt. This inspector never runs or retries an action.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo verificar este recibo. Este inspector nunca ejecuta ni reintenta una acción."
          }
        }
      }
    },
    "Portavoz could not verify whether the reminder was created. Check Reminders before retrying.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo verificar si se creó el recordatorio. Comprueba Recordatorios antes de volver a intentarlo."
          }
        }
      }
    },
    "Portavoz found partial audio but could not save its recovery state. Keep the app open and export support diagnostics.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz encontró audio parcial, pero no pudo guardar su estado de recuperación. Mantén la app abierta y exporta los diagnósticos de soporte."
          }
        }
      }
    },
    "Portavoz is already stopping the recording. Open Portavoz to view progress.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz ya está deteniendo la grabación. Abre Portavoz para ver el progreso."
          }
        }
      }
    },
    "Portavoz is idle": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz en reposo"
          }
        }
      }
    },
    "Portavoz is still starting the recording. Run Stop recording again when the live controls appear.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz todavía está iniciando la grabación. Ejecuta Detener la grabación de nuevo cuando aparezcan los controles en vivo."
          }
        }
      }
    },
    "Portavoz is stopping the current recording.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz está deteniendo la grabación actual."
          }
        }
      }
    },
    "Portavoz leaves macOS voice processing to your meeting app and never enables call-audio ducking while it records. Duplicate speaker bleed is removed from the transcript after capture.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz deja el procesamiento de voz de macOS en manos de tu app de reuniones y nunca atenúa el audio de la llamada mientras graba. Las voces remotas duplicadas se eliminan del transcript después de la captura."
          }
        }
      }
    },
    "Portavoz never guesses a repository.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz nunca adivina un repositorio."
          }
        }
      }
    },
    "Portavoz preserved recovery evidence but could not finalize the recording.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz conservó la evidencia de recuperación, pero no pudo finalizar la grabación."
          }
        }
      }
    },
    "Portavoz preserved the meeting, but automatic recovery could not finish.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz conservó la reunión, pero la recuperación automática no pudo finalizar."
          }
        }
      }
    },
    "Portavoz records locally; macOS asks for each permission once.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz graba localmente; macOS pide cada permiso una sola vez."
          }
        }
      }
    },
    "Portavoz sends nothing. The transcript is never included.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no envía nada. La transcripción nunca se incluye."
          }
        }
      }
    },
    "Portavoz stopped before starting background work. Your original library has not been changed or deleted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz se detuvo antes de iniciar tareas en segundo plano. Tu biblioteca original no se ha modificado ni eliminado."
          }
        }
      }
    },
    "Portavoz suggests actions based on evidence from your meetings. Nothing runs until you review and confirm it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz sugiere acciones a partir de evidencia de tus reuniones. Nada se ejecuta hasta que revisas y confirmas cada acción."
          }
        }
      }
    },
    "Portavoz will ask only when you choose Allow Reminders Access.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz solo solicitará acceso cuando elijas Permitir acceso a Recordatorios."
          }
        }
      }
    },
    "Portavoz will handle the stop request after it finishes opening.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz procesará la solicitud de detención cuando termine de abrirse."
          }
        }
      }
    },
