        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto cifrado de las reuniones y los metadatos portátiles se sincronizan mediante tu base de datos privada de iCloud. El audio, las rutas de archivos locales, las huellas de voz, los secretos y los embeddings nunca se sincronizan."
          }
        }
      }
    },
    "Encrypted numeric fingerprints of voices you chose to remember, used only to suggest names in future meetings — never audio, never synced. Right-click a name to forget one voice.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Huellas numéricas cifradas de las voces que elegiste recordar, usadas solo para sugerir nombres en futuras reuniones — nunca audio, nunca se sincronizan. Haz click derecho en un nombre para olvidar una voz."
          }
        }
      }
    },
