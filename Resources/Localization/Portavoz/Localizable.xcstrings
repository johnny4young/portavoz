        }
      }
    },
    "Another refine is already running — try again when it finishes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay otro refine en curso: inténtalo cuando termine."
          }
        }
      }
    },
    "Answer Apuntador knowledge questions with this provider": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder preguntas de conocimiento del Apuntador con este proveedor"
