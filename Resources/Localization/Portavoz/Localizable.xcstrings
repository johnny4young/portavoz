      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparar cada brief próximo"
          }
        }
      }
    },
    "Prepare once to add meaning-based English and Spanish matches. Preparing may use a few hundred MB on this Mac; macOS manages the assets, and exact search stays available.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepárala una vez para añadir coincidencias por significado en inglés y español. Prepararla puede usar unos cientos de MB en este Mac; macOS gestiona los recursos y la búsqueda exacta sigue disponible."
          }
        }
      }
    },
    "Prepare semantic search": {
      "localizations": {
        "es": {
          "stringUnit": {
