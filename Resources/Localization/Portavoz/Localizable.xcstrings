      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuentes de la respuesta"
          }
        }
      }
    },
    "Answers only from what was said earlier. Otherwise Portavoz stays quiet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde solo con lo dicho antes. Si no, Portavoz se queda callado."
          }
        }
      }
    },
    "Any /chat/completions endpoint works, including a local Ollama or LM Studio server. Apuntador sends only the detected question, never audio or meeting text.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirve cualquier endpoint /chat/completions, incluido un servidor local de Ollama o LM Studio. Apuntador envía solo la pregunta detectada, nunca audio ni texto de la reunión."
