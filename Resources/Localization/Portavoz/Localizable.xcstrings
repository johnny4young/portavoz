    "Press keys…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona las teclas…"
          }
        }
      }
    },
    "Press ⌥⌘D in any app, speak, press it again: your words are typed where your cursor is — transcribed on this Mac with your custom vocabulary, never stored. Inserting text needs the Accessibility permission (macOS asks on first use).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona ⌥⌘D en cualquier app, habla y presiónalo de nuevo: tus palabras se escriben donde está tu cursor — transcritas en esta Mac con tu vocabulario, jamás se guardan. Insertar texto requiere el permiso de Accesibilidad (macOS lo pide la primera vez)."
          }
        }
      }
    },
