    "Portavoz could not check the iCloud account. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo comprobar la cuenta de iCloud. Inténtalo de nuevo."
          }
        }
      }
    },
    "Portavoz could not create a safe local recording. Try again; no audio was started.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo crear una grabación local segura. Vuelve a intentarlo; no se inició ningún audio."
          }
        }
      }
    },
    "Portavoz could not find your default Reminders list. Choose one in Reminders, then check again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo encontrar tu lista predeterminada de Recordatorios. Elige una en Recordatorios y vuelve a comprobar."
          }
        }
      }
    },
    "Portavoz could not finish saving the recording. Keep the app open and export support diagnostics.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo terminar de guardar la grabación. Mantén la app abierta y exporta los diagnósticos de soporte."
          }
        }
      }
    },
    "Portavoz could not open the recording screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo abrir la pantalla de grabación."
          }
        }
      }
    },
    "Portavoz could not prepare the private iCloud transport.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo preparar el transporte privado de iCloud."
          }
        }
      }
    },
    "Portavoz could not prepare the recording devices. Check permissions and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo preparar los dispositivos de grabación. Revisa los permisos y vuelve a intentarlo."
          }
        }
      }
    },
    "Portavoz could not read commitments. Open Portavoz and use the recovery action shown.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo leer los compromisos. Abre Portavoz y usa la acción de recuperación que se muestra."
          }
        }
      }
    },
    "Portavoz could not read the library. Open Portavoz and use the recovery action shown.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo leer la biblioteca. Abre Portavoz y usa la acción de recuperación que se muestra."
          }
        }
      }
    },
    "Portavoz could not safely reconcile an empty recording. Export support diagnostics before trying again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo reconciliar de forma segura una grabación vacía. Exporta los diagnósticos de soporte antes de volver a intentarlo."
          }
        }
      }
    },
    "Portavoz could not verify the blocker evidence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portavoz no pudo verificar la evidencia del bloqueador."
          }
        }
