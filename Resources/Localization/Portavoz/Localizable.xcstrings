{
  "sourceLanguage": "en",
  "strings": {
    "The first confirmed discussion needs current transcript evidence before Portavoz can show it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera conversación confirmada necesita evidencia actual de la transcripción antes de que Portavoz pueda mostrarla."
          }
        }
      }
    },
    "Choose one confirmed topic and a memory view. Portavoz uses the exact identity you select and only shows source-backed facts you explicitly confirmed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un tema confirmado y una vista de memoria. Portavoz usa la identidad exacta que selecciones y solo muestra hechos respaldados por fuentes que confirmaste explícitamente."
          }
        }
      }
    },
    "Confirmed topic: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema confirmado: %@"
          }
        }
      }
    },
    "Could not load the first confirmed discussion.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la primera conversación confirmada."
