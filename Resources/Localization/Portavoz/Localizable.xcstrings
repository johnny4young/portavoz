    },
    "Another app or the system may reserve it. Choose another combination or retry.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede estar reservado por otra app o por el sistema. Elige otra combinación o reintenta."
