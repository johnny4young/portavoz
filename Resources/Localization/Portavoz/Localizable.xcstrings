    },
    "Apple's optional answer enhancement is unavailable: %@. The bundled detector still works fully offline and shows question-only cards; explicitly enabled BYOK remains limited to general knowledge questions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
